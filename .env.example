# Copia aquest fitxer a .env (no el pugis mai al repositori) i omple els valors.

# --- Domini (registre A del teu hosting apuntant a la IP del VPS)
RADAR_DOMINI=radar.exemple.com

# --- Accés (genera-ho amb: docker compose run --rm app python -m radar contrasenya)
# Copia les línies tal com surten, amb les cometes simples (el hash conté «$»).
RADAR_USUARI=xavi
RADAR_CONTRASENYA_HASH=
RADAR_SECRET=
# Segon factor opcional (codi de 6 xifres a l'app d'autenticació del mòbil)
RADAR_TOTP_SECRET=
RADAR_HORES_SESSIO=12

# --- Assistent de propostes (https://console.anthropic.com)
ANTHROPIC_API_KEY=
RADAR_MODEL=claude-opus-5-5
# low / medium / high / xhigh / max
RADAR_ESFORC=high
RADAR_CERCA_WEB=true
RADAR_MIDA_MAX_MB=25

# --- Revisió de cada matí
RADAR_HORA=07:30
RADAR_ZONA_HORARIA=Europe/Madrid

# --- Correu dels avisos (SMTP del vostre proveïdor; amb Gmail/Google Workspace, una contrasenya d'aplicació)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RADAR_DESTINATARI=

# --- Holded (clau d'API; només es fa servir per llegir contactes)
HOLDED_API_KEY=
